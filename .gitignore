__pycache__/
*.py[cod]
.pytest_cache/

# Private runtime/qualification state, reports, copied runtimes and screenshots.
evidence/
/smoke-home/
/benchmarks/results-*/**
!/benchmarks/results-*/MEASUREMENTS.md
*.log
*.jsonl
*.db
*.db-*
*.sqlite*
*.zip
*.tar
*.tar.gz
*.tgz
*.so
*.dylib
*.exe

# Local secrets and editor state; test fixtures remain source-owned.
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials.json
auth.json
.DS_Store
.idea/
.vscode/
*.swp
*.orig
*.bak
