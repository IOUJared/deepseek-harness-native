# Local builds/dependencies: publish source and lockfiles, never binaries or caches.
target/
node_modules/
.cargo-home/
.pnpm-store/
dist/
build-output/
/benchmarks/qualification*/
/benchmarks/iced/qualification*/
/benchmarks/slint/qualification*/
